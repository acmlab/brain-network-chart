# =============================================================================
# brain-network-chart Docker environment configuration
# Copy this file to .env and fill in your paths before running docker compose.
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

# Absolute path to your BIDS-formatted input data (read-only inside container)
# Linux/Mac example:
DATA_INPUT_PATH=/ram/USERS/tao/code/new/NACC_Data
# Windows example:
# DATA_INPUT_PATH=C:/Users/user/mybids

# Absolute path for pipeline outputs (files written here appear on your host)
DATA_OUTPUT_PATH=/ram/USERS/tao/code/new/NACC_Data_docker_out
# DATA_OUTPUT_PATH=C:/Users/user/bids_output

# Absolute path to your FreeSurfer license file
# Free registration at: https://surfer.nmr.mgh.harvard.edu/registration.html
FS_LICENSE_PATH=/export_home/taowen/freesurfer/license.txt
# FS_LICENSE_PATH=C:/Users/user/freesurfer/license.txt

# ── Optional ─────────────────────────────────────────────────────────────────

# Short identifier used to name working subdirectories in output
USER_TAG=myname
