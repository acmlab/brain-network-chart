# Copy this file to .env and fill in your values:
#   cp docker/.env.example docker/.env

# Directory for input DICOM data (mounted read-only into bids-runner)
DATA_INPUT_PATH=/path/to/your/dicom_data

# Directory for pipeline output (BIDS, fMRIPrep results, etc.)
DATA_OUTPUT_PATH=/path/to/your/output

# FreeSurfer license file (required for fMRIPrep, QSIPrep, etc.)
FS_LICENSE_PATH=/path/to/your/freesurfer/license.txt

# Your username tag (used in output directory structure)
USER_TAG=myuser
